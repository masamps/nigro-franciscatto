<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Deixa o index.html passar direto
  RewriteRule ^index\.html$ - [L]

  # Se o caminho pedido for um arquivo OU uma pasta que existe de verdade
  # (PDF, imagens, assets, etc.), serve o arquivo e NÃO reescreve.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outra coisa (rotas do React: /artigos, /sobre...) cai no index.html
  RewriteRule . /index.html [L]
</IfModule>
